apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://{{ hostvars[groups['monitoring'][0]].ansible_host }}:9090
    isDefault: true
    editable: false

  - name: Loki
    type: loki
    access: proxy
    url: http://{{ hostvars[groups['monitoring'][0]].ansible_host }}:3100
    editable: false
