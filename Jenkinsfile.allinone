// =============================================================================
// Jenkinsfile – All-in-One CI/CD Pipeline (mentor style: Push CD)
//                  DÙNG HASHICORP VAULT PLUGIN (không CLI, không file trung gian)
//
// JENKINS CẤU HÌNH (1 lần: Manage Jenkins → Configure System → HashiCorp Vault):
//   Vault URL:  http://<NLB_DNS>:8200
//   Credential: Vault App Role (role-id + secret-id từ vault-init.sh)
//   K/V Engine Version: 2
//
// JENKINS CREDENTIALS:
//   + vault-approle-jenkins  (Vault App Role)
//   + kubeconfig             (Secret file – upload ~/.kube/config)
//
// VAULT STRUCTURE:
//   secret/common/registry   → dockerhub_user, dockerhub_password
//   secret/common/tools      → sonarqube_token
//   secret/demo-app/mysql    → root-password, database, username, password
// =============================================================================
pipeline {
    agent any

    parameters {
        string(name: 'PROJECT_NAME',  defaultValue: 'demo-app', description: 'Tên project')
        choice(name: 'ENVIRONMENT',   choices: ['dev', 'stg', 'prd'], description: 'Môi trường')
        string(name: 'GIT_BRANCH',    defaultValue: 'Week-8-CI-full', description: 'Branch')
        string(name: 'MODULE_DEPLOY', defaultValue: 'backend,frontend', description: 'backend,frontend')
        string(name: 'DOCKER_BACKEND_REPO', defaultValue: 'lehoangtien2510/ecommerce-backend', description: 'Backend repo')
        string(name: 'DOCKER_FRONTEND_REPO', defaultValue: 'lehoangtien2510/ecommerce-frontend', description: 'Frontend repo')
        string(name: 'KUBE_NAMESPACE', defaultValue: '', description: 'Namespace (trống = PROJECT-ENV)')
        string(name: 'KUBE_CONFIG_CRED', defaultValue: 'kubeconfig', description: 'Credential kubeconfig')
    }

    environment {
        KUBE_NAMESPACE = "${params.KUBE_NAMESPACE ?: params.PROJECT_NAME + '-' + params.ENVIRONMENT}"
        IMAGE_TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
        DEPLOY_BE = "${params.MODULE_DEPLOY.contains('backend')}"
        DEPLOY_FE = "${params.MODULE_DEPLOY.contains('frontend')}"

        // ═══ TẤT CẢ SECRET TỪ VAULT PLUGIN (AppRole) ═══
        DOCKERHUB_USER  = vault path: 'secret/common/registry', key: 'dockerhub_user'
        DOCKERHUB_PASS  = vault path: 'secret/common/registry', key: 'dockerhub_password'
        SONARQUBE_TOKEN = vault path: 'secret/common/tools',    key: 'sonarqube_token'
        MYSQL_ROOT_PWD  = vault path: 'secret/demo-app/mysql',  key: 'root-password'
        MYSQL_DB        = vault path: 'secret/demo-app/mysql',  key: 'database'
        MYSQL_USR       = vault path: 'secret/demo-app/mysql',  key: 'username'
        MYSQL_PWD       = vault path: 'secret/demo-app/mysql',  key: 'password'
    }

    stages {

        stage('1. Verify') {
            steps { sh 'docker --version && git --version && kubectl version --client --short 2>/dev/null; echo "✅"' }
        }

        stage('2. Checkout') { steps { checkout scm } }

        stage('3. Docker Login') {
            steps { sh 'echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin' }
        }

        stage('4. Lint') {
            parallel {
                stage('BE') { when { expression { env.DEPLOY_BE == 'true' } }
                    steps { dir('src/02-backend_spring-boot-rest-api') { sh 'chmod +x mvnw && ./mvnw checkstyle:check -Dcheckstyle.skip=false || true' } }
                }
                stage('FE') { when { expression { env.DEPLOY_FE == 'true' } }
                    steps { dir('src/03-frontend_angular-ecommerce') { sh 'docker run --rm -v $(pwd):/app -w /app node:18-alpine sh -c "npm install && npx ng lint --fix" || true' } }
                }
            }
        }

        stage('5. Test') {
            parallel {
                stage('BE') { when { expression { env.DEPLOY_BE == 'true' } }
                    steps { dir('src/02-backend_spring-boot-rest-api') { sh 'chmod +x mvnw && ./mvnw test jacoco:report' } }
                }
                stage('FE') { when { expression { env.DEPLOY_FE == 'true' } }
                    steps { dir('src/03-frontend_angular-ecommerce') { sh 'docker run --rm -v $(pwd):/app -w /app node:18-alpine sh -c "npm install && npx ng test --watch=false --browsers=ChromeHeadlessNoSandbox" || true' } }
                }
            }
        }

        stage('6. SonarQube') {
            when { expression { env.DEPLOY_BE == 'true' } }
            steps { dir('src/02-backend_spring-boot-rest-api') { sh 'chmod +x mvnw && ./mvnw sonar:sonar -Dsonar.projectKey=${PROJECT_NAME} -Dsonar.host.url=http://localhost:9000 -Dsonar.token=${SONARQUBE_TOKEN}' } }
        }

        stage('7. Build & Push') {
            parallel {
                stage('BE') { when { expression { env.DEPLOY_BE == 'true' } }
                    steps { dir('src/02-backend_spring-boot-rest-api') { sh 'docker build -t ${DOCKER_BACKEND_REPO}:${IMAGE_TAG} -t ${DOCKER_BACKEND_REPO}:latest . && docker push ${DOCKER_BACKEND_REPO}:${IMAGE_TAG} && docker push ${DOCKER_BACKEND_REPO}:latest && echo "✅ BE: ${IMAGE_TAG}"' } }
                }
                stage('FE') { when { expression { env.DEPLOY_FE == 'true' } }
                    steps { dir('src/03-frontend_angular-ecommerce') { sh 'docker build -t ${DOCKER_FRONTEND_REPO}:${IMAGE_TAG} -t ${DOCKER_FRONTEND_REPO}:latest . && docker push ${DOCKER_FRONTEND_REPO}:${IMAGE_TAG} && docker push ${DOCKER_FRONTEND_REPO}:latest && echo "✅ FE: ${IMAGE_TAG}"' } }
                }
            }
        }

        stage('8. Trivy') {
            parallel {
                stage('BE') { when { expression { env.DEPLOY_BE == 'true' } }
                    steps { sh 'trivy image --severity HIGH,CRITICAL ${DOCKER_BACKEND_REPO}:${IMAGE_TAG} || echo "⚠️"' }
                }
                stage('FE') { when { expression { env.DEPLOY_FE == 'true' } }
                    steps { sh 'trivy image --severity HIGH,CRITICAL ${DOCKER_FRONTEND_REPO}:${IMAGE_TAG} || echo "⚠️"' }
                }
            }
        }

        stage('9. Create K8s Secrets') {
            steps {
                withCredentials([file(credentialsId: params.KUBE_CONFIG_CRED, variable: 'KCFG')]) {
                    sh '''
                        export KUBECONFIG=${KCFG}
                        kubectl create ns ${KUBE_NAMESPACE} --dry-run=client -o yaml | kubectl apply --validate=false -f -
                        kubectl create secret generic mysql-secret -n ${KUBE_NAMESPACE} \
                          --from-literal=mysql-root-password="${MYSQL_ROOT_PWD}" \
                          --from-literal=mysql-database="${MYSQL_DB}" \
                          --from-literal=mysql-user="${MYSQL_USR}" \
                          --from-literal=mysql-password="${MYSQL_PWD}" \
                          --dry-run=client -o yaml | kubectl apply --validate=false -f -
                        echo "✅ mysql-secret in ${KUBE_NAMESPACE}"
                    '''
                }
            }
        }

        stage('10. Deploy') {
            steps {
                withCredentials([file(credentialsId: params.KUBE_CONFIG_CRED, variable: 'KCFG')]) {
                    script {
                        def cmds = "export KUBECONFIG=\${KCFG}\n"
                        if (env.DEPLOY_BE == 'true') {
                            cmds += "kubectl argo rollouts set image --insecure-skip-tls-verify ecommerce-backend backend=${params.DOCKER_BACKEND_REPO}:${IMAGE_TAG} -n ${KUBE_NAMESPACE}\n"
                            cmds += "kubectl argo rollouts status --insecure-skip-tls-verify ecommerce-backend -n ${KUBE_NAMESPACE} --timeout 10m\n"
                            cmds += "echo '✅ Backend deployed'\n"
                        }
                        if (env.DEPLOY_FE == 'true') {
                            cmds += "kubectl argo rollouts set image --insecure-skip-tls-verify ecommerce-frontend frontend=${params.DOCKER_FRONTEND_REPO}:${IMAGE_TAG} -n ${KUBE_NAMESPACE}\n"
                            cmds += "kubectl argo rollouts promote --insecure-skip-tls-verify ecommerce-frontend -n ${KUBE_NAMESPACE} 2>/dev/null || true\n"
                            cmds += "kubectl argo rollouts status --insecure-skip-tls-verify ecommerce-frontend -n ${KUBE_NAMESPACE} --timeout 5m\n"
                            cmds += "echo '✅ Frontend deployed'\n"
                        }
                        sh cmds
                    }
                }
            }
        }
    }

    post {
        always {
            withCredentials([file(credentialsId: params.KUBE_CONFIG_CRED, variable: 'KCFG')]) {
                sh 'export KUBECONFIG=${KCFG}; kubectl -n ${KUBE_NAMESPACE} get pods -o wide --validate=false || true'
            }
        }
        success { echo "✅ ${params.PROJECT_NAME}/${params.ENVIRONMENT} @ ${IMAGE_TAG}" }
        failure { echo "❌ FAILED" }
    }
}
