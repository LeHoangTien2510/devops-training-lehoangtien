# =============================================================================
# Vault Secrets Configuration
# =============================================================================
# Copy file này thành vault.env và điền password thật:
#   cp vault.env.example vault.env
#   vim vault.env
#
# ⚠️  vault.env đã được thêm vào .gitignore – KHÔNG COMMIT!
# =============================================================================

# MySQL credentials (sẽ được lưu vào Vault)
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=full-stack-ecommerce
MYSQL_USER=ecommerceapp
