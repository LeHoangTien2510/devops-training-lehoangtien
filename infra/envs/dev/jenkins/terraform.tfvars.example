# =============================================================================
# Terraform tfvars example – Jenkins môi trường Dev
# =============================================================================
# Copy file này thành terraform.tfvars và điền key_name
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================
aws_region  = "us-east-1"
aws_profile = "root-lab-2"
environment = "dev"

jenkins_instance_type    = "t3.medium"
jenkins_root_volume_size = 30
key_name                 = ""   # <-- ĐIỀN TÊN KEY PAIR CỦA BẠN
